{
  "name": "oldman-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for Oldman, built from docs/public/<language>/",
  "scripts": {
    "stage": "uv run --project .. python ../scripts/build-docs-site.py",
    "check": "uv run --project .. python ../scripts/build-docs-site.py check",
    "start": "pnpm stage && docusaurus start",
    "build": "pnpm stage && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "prism-react-renderer": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2"
  },
  "engines": {
    "node": ">=20"
  }
}
